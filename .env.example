# ─── Database (Supabase PostgreSQL) ────────────────────────────────────────
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Use the "Transaction" pooler connection string (port 6543) for serverless
DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Payload CMS ────────────────────────────────────────────────────────────
# Generate a random 32+ char string: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-here

# ─── Next.js ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Vercel Blob Storage (for media uploads) ────────────────────────────────
# Get from Vercel Dashboard → Storage → Create Blob Store → .env.local
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# ─── Cron Security (optional) ───────────────────────────────────────────────
CRON_SECRET=your-cron-secret
